# API Keys for Aesthetic Medicine Search Engine
# Copy this file to .env and fill in your actual keys

# OpenRouter API (REQUIRED)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# SerpData API (REQUIRED)
# Get your key at: https://serpdata.io/api-keys
SERPDATA_KEY=...

# Jina AI API (OPTIONAL - for reranking)
# Get your key at: https://jina.ai/
JINA_API_KEY=...

# Configuration (optional, can be set via CLI args)
PROJECT_NAME=baza_zabiegow_v0
MAX_KEYWORDS=20
MAX_DOMAINS=50
MAX_PAGES_PER_DOMAIN=12
SEMANTIC_SIM_THRESHOLD=0.22
